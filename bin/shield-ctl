#!/usr/bin/env python3
import argparse
import glob
import os
import shlex
import subprocess
import sys


def find_niri_socket():
    if "NIRI_SOCKET" in os.environ:
        sock = os.environ.get("NIRI_SOCKET", "").strip()
        if sock:
            return sock
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    matches = sorted(glob.glob(f"{runtime_dir}/niri.*.sock"))
    if matches and os.path.exists(matches[0]):
        return matches[0]
    return None


def find_hyprland_socket():
    if "HYPRLAND_INSTANCE_SIGNATURE" in os.environ:
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "").strip()
        if sig:
            return sig
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    matches = glob.glob(f"{runtime_dir}/hypr/*/.socket*.sock") + glob.glob("/tmp/hypr/*/.socket*.sock")
    if matches:
        return matches[0]
    return None


def find_sway_socket():
    if "SWAYSOCK" in os.environ:
        sock = os.environ.get("SWAYSOCK", "").strip()
        if sock:
            return sock
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    matches = sorted(glob.glob(f"{runtime_dir}/sway-ipc.*.sock"))
    if matches and os.path.exists(matches[0]):
        return matches[0]
    return None


def detect_backend():
    if os.environ.get("NIRI_SOCKET", "").strip():
        return "niri"
    if os.environ.get("SWAYSOCK", "").strip():
        return "sway"
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "").strip():
        return "hyprland"
    if find_niri_socket():
        return "niri"
    if find_hyprland_socket():
        return "hyprland"
    if find_sway_socket():
        return "sway"
    return None


def resolve_backend(cli_backend):
    if cli_backend:
        backend = cli_backend.strip().lower()
        if backend in ("niri", "sway", "hyprland"):
            return backend
        sys.stderr.write(f"error: unsupported backend '{cli_backend}'\n")
        sys.exit(2)
    env_backend = os.environ.get("SHIELD_BACKEND", "").strip().lower()
    if env_backend:
        if env_backend in ("niri", "sway", "hyprland"):
            return env_backend
        sys.stderr.write(f"error: unsupported SHIELD_BACKEND '{env_backend}'\n")
        sys.exit(2)
    detected = detect_backend()
    if detected:
        return detected
    sys.stderr.write("error: no supported compositor backend detected\n")
    sys.exit(1)


def is_dry_run(cli_dry_run):
    if cli_dry_run:
        return True
    return os.environ.get("SHIELD_DRY_RUN", "").strip().lower() in ("1", "true", "yes")


def format_command(backend, subcommand, target, extra=None):
    if subcommand == "workspace":
        clean_ws = str(target).strip().lower()
        if clean_ws in ("next", "down"):
            if backend == "niri":
                return "niri msg action focus-workspace-down"
            if backend == "sway":
                return "swaymsg workspace next"
            if backend == "hyprland":
                return "hyprctl dispatch workspace e+1"
        if clean_ws in ("prev", "up"):
            if backend == "niri":
                return "niri msg action focus-workspace-up"
            if backend == "sway":
                return "swaymsg workspace prev"
            if backend == "hyprland":
                return "hyprctl dispatch workspace e-1"
        try:
            ws_num = int(target)
            if ws_num < 1:
                raise ValueError
        except ValueError:
            sys.stderr.write(f"error: workspace target must be a positive integer or next/prev, got '{target}'\n")
            sys.exit(1)
        if backend == "niri":
            return f"niri msg action focus-workspace {ws_num}"
        if backend == "sway":
            return f"swaymsg workspace number {ws_num}"
        if backend == "hyprland":
            return f"hyprctl dispatch workspace {ws_num}"

    if subcommand == "focus":
        clean_target = str(target).strip()
        if not clean_target:
            sys.stderr.write("error: focus target window id cannot be empty\n")
            sys.exit(1)
        if backend == "niri":
            return f"niri msg action focus-window --id {clean_target}"
        if backend == "sway":
            return f"swaymsg [con_id={clean_target}] focus"
        if backend == "hyprland":
            if any(clean_target.startswith(p) for p in ("address:", "pid:", "class:", "title:")):
                focus_arg = clean_target
            else:
                focus_arg = f"address:{clean_target}"
            return f"hyprctl dispatch focuswindow {focus_arg}"

    if subcommand in ("media", "play-pause"):
        action = str(target).strip() if (target and subcommand != "play-pause") else "play-pause"
        return f"playerctl {action}"

    if subcommand in ("bridge-toggle", "bridge"):
        return "true"

    if subcommand in ("audio", "toggle-mute"):
        return "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"

    if subcommand == "volume":
        clean_action = str(target).strip().lower() if target else ""
        if clean_action == "up":
            return "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"
        if clean_action == "down":
            return "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
        if clean_action == "get":
            return "wpctl get-volume @DEFAULT_AUDIO_SINK@"
        if clean_action == "set":
            if not extra or not str(extra).strip():
                sys.stderr.write("error: volume set requires a value\n")
                sys.exit(1)
            val = str(extra).strip()
            if val.isdigit():
                val = f"{val}%"
            return f"wpctl set-volume @DEFAULT_AUDIO_SINK@ {val}"
        sys.stderr.write(f"error: unknown volume action '{target}'\n")
        sys.exit(1)

    if subcommand == "dnd":
        return "makoctl mode -t dnd"

    if subcommand == "night-light":
        return "wlsunset -t 4500"

    sys.stderr.write(f"error: unknown subcommand '{subcommand}'\n")
    sys.exit(1)


def main():
    parent_parser = argparse.ArgumentParser(add_help=False)
    parent_parser.add_argument("--dry-run", action="store_true", default=argparse.SUPPRESS)
    parent_parser.add_argument("--backend", choices=["niri", "sway", "hyprland"], default=argparse.SUPPRESS)

    parser = argparse.ArgumentParser(prog="shield-ctl", parents=[parent_parser])
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    ws_parser = subparsers.add_parser("workspace", parents=[parent_parser])
    ws_parser.add_argument("target")

    focus_parser = subparsers.add_parser("focus", parents=[parent_parser])
    focus_parser.add_argument("target")

    media_parser = subparsers.add_parser("media", parents=[parent_parser])
    media_parser.add_argument("action", nargs="?", default="play-pause", choices=["play-pause", "next", "prev", "play", "pause"])

    subparsers.add_parser("play-pause", parents=[parent_parser])

    audio_parser = subparsers.add_parser("audio", parents=[parent_parser])
    audio_parser.add_argument("action", nargs="?", default="mute-toggle", choices=["mute-toggle"])

    subparsers.add_parser("toggle-mute", parents=[parent_parser])

    vol_parser = subparsers.add_parser("volume", parents=[parent_parser])
    vol_parser.add_argument("action", choices=["up", "down", "set", "get"])
    vol_parser.add_argument("value", nargs="?", default=None)

    dnd_parser = subparsers.add_parser("dnd", parents=[parent_parser])
    dnd_parser.add_argument("action", nargs="?", default="toggle", choices=["toggle"])

    nl_parser = subparsers.add_parser("night-light", parents=[parent_parser])
    nl_parser.add_argument("action", nargs="?", default="toggle", choices=["toggle"])

    subparsers.add_parser("bridge-toggle", parents=[parent_parser])

    args = parser.parse_args()

    dry_run = is_dry_run(getattr(args, "dry_run", False))

    if args.subcommand in ("workspace", "focus"):
        backend = resolve_backend(getattr(args, "backend", None))
        cmd_str = format_command(backend, args.subcommand, args.target)
    elif args.subcommand == "volume":
        cmd_str = format_command(None, args.subcommand, args.action, getattr(args, "value", None))
    else:
        target_val = getattr(args, "action", None)
        cmd_str = format_command(None, args.subcommand, target_val)

    if dry_run:
        print(cmd_str)
        sys.exit(0)

    cmd_args = shlex.split(cmd_str)
    try:
        proc = subprocess.run(cmd_args)
        sys.exit(proc.returncode)
    except FileNotFoundError:
        sys.stderr.write(f"error: command '{cmd_args[0]}' not found\n")
        sys.exit(127)
    except Exception as exc:
        sys.stderr.write(f"error: {exc}\n")
        sys.exit(1)


if __name__ == "__main__":
    main()
