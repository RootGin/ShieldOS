{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shield-os.local/schemas/state.schema.json",
  "title": "S.H.I.E.L.D. OS HUD State Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "telemetry",
    "compositor",
    "network_audio"
  ],
  "properties": {
    "telemetry": {
      "$ref": "#/$defs/telemetry"
    },
    "compositor": {
      "$ref": "#/$defs/compositor"
    },
    "network_audio": {
      "$ref": "#/$defs/network_audio"
    }
  },
  "$defs": {
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "day",
        "month_year",
        "weekday",
        "cpu_percent",
        "cpu_load",
        "ram_percent",
        "user",
        "kernel",
        "version",
        "cpu_ladder",
        "ram_ladder"
      ],
      "properties": {
        "time": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
        },
        "day": {
          "type": "string",
          "pattern": "^\\d{2}$"
        },
        "month_year": {
          "type": "string",
          "pattern": "^[A-Z]{3} - \\d{4}$"
        },
        "weekday": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "cpu_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "cpu_load": {
          "type": "number",
          "minimum": 0
        },
        "ram_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "kernel": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "quick_tabs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mute",
            "dnd",
            "night_light"
          ],
          "properties": {
            "mute": {
              "type": "boolean"
            },
            "dnd": {
              "type": "boolean"
            },
            "night_light": {
              "type": "boolean"
            }
          }
        },
        "cpu_ladder": {
          "$ref": "#/$defs/ladder_gauge"
        },
        "ram_ladder": {
          "$ref": "#/$defs/ladder_gauge"
        }
      }
    },
    "compositor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "workspaces",
        "tabs"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "niri",
            "hyprland",
            "sway",
            "none"
          ]
        },
        "workspaces": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "state"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "state": {
                "type": "string",
                "enum": [
                  "empty",
                  "occupied",
                  "active"
                ]
              }
            }
          }
        },
        "tabs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tag",
              "title",
              "badge",
              "urgent"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "tag": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "badge": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "urgent": {
                "type": "boolean"
              }
            }
          }
        },
        "windows": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tag",
              "title",
              "badge",
              "urgent"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "tag": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "badge": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "urgent": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "network_audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connected",
        "label",
        "signal",
        "audio_level",
        "media"
      ],
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "signal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "audio_level": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "muted": {
          "type": "boolean"
        },
        "volume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "playing"
          ],
          "properties": {
            "playing": {
              "type": "boolean"
            },
            "title": {
              "type": "string"
            },
            "artist": {
              "type": "string"
            },
            "progress": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "slots": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        "quick_tabs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mute",
            "dnd",
            "night_light"
          ],
          "properties": {
            "mute": {
              "type": "boolean"
            },
            "dnd": {
              "type": "boolean"
            },
            "night_light": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ladder_gauge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "rungs"
      ],
      "properties": {
        "bucket": {
          "type": "integer",
          "enum": [
            0,
            20,
            40,
            60,
            80,
            100
          ]
        },
        "rungs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "sublabel",
              "state"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "sublabel": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "normal",
                  "lit",
                  "active"
                ]
              }
            }
          }
        }
      }
    }
  }
}
