(defwindow zone-top
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "68px" :anchor "top center")
  :layer "bottom"
  :exclusive true
  :focusable false
  :namespace "shield-zone-top"
  (box :class "exclusive-zone"))

(defwindow zone-bottom
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "60px" :anchor "bottom center")
  :layer "bottom"
  :exclusive true
  :focusable false
  :namespace "shield-zone-bottom"
  (box :class "exclusive-zone"))

(defwindow zone-left
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "56px" :height "100%" :anchor "center left")
  :layer "bottom"
  :exclusive true
  :focusable false
  :namespace "shield-zone-left"
  (box :class "exclusive-zone"))

(defwindow zone-right
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "58px" :height "100%" :anchor "center right")
  :layer "bottom"
  :exclusive true
  :focusable false
  :namespace "shield-zone-right"
  (box :class "exclusive-zone"))
