(defwindow background
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "100%"
                      :height "100%"
                      :anchor "top left")
  :stacking "bottom"
  :exclusive false
  :focusable false
  :namespace "shield-background"
  (box :class "background-void"
       :hexpand true
       :vexpand true
       (box :class "canvas"
            :hexpand true
            :vexpand true
            (overlay
              (box :class "canvas-base"
                   :width 1888
                   :height 1048
                   (label :visible false
                          :text "${telemetry.time} ${telemetry.day} ${telemetry.month_year} ${telemetry.weekday}"))
              (box :class "data-noise-layer" :halign "center" :valign "center" :width 1888 :height 1048
                (image :path "./assets/data-noise.svg" :image-width 1888 :image-height 1048))
              (box :class "glow-layer" :halign "center" :valign "center" :width 800 :height 800
                (image :path "./assets/glow.svg" :image-width 800 :image-height 800))
              (box :class "star-ring-layer" :halign "center" :valign "center" :width 800 :height 800
                (image :path "./assets/star-ring.svg" :image-width 800 :image-height 800))
              (box :class "placeholder-layer" :halign "center" :valign "center" :width 800 :height 800
                (image :path "./assets/placeholder.svg" :image-width 800 :image-height 800))))))
