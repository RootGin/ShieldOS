(defwindow background
  :monitor 0
  :geometry (geometry :x "-56px"
                      :y "-108px"
                      :width "100%"
                      :height "100%"
                      :anchor "top left")
  :stacking "bottom"
  :exclusive false
  :focusable false
  :namespace "shield-background"
  (box :class "background-void"
       :hexpand true
       :vexpand true
       (box :class "canvas"
            :hexpand true
            :vexpand true
            (overlay
              (box :class "canvas-base"
                   :width canvas_width
                   :height canvas_height
                   (label :visible false
                          :text "${telemetry.time} ${telemetry.day} ${telemetry.month_year} ${telemetry.weekday}"))
              (box :class "data-noise-layer" :halign "center" :valign "center" :width canvas_width :height canvas_height
                (image :path "./assets/data-noise.svg" :image-width canvas_width :image-height canvas_height))
              (box :class "glow-layer" :halign "center" :valign "center" :width emblem_size :height emblem_size
                (image :path "./assets/glow.svg" :image-width emblem_size :image-height emblem_size))
              (box :class "star-ring-layer" :halign "center" :valign "center" :width emblem_size :height emblem_size
                (image :path "./assets/star-ring.svg" :image-width emblem_size :image-height emblem_size))
              (box :class "emblem-layer" :halign "center" :valign "center" :width emblem_size :height emblem_size
                (image :path "./assets/emblem.svg" :image-width emblem_size :image-height emblem_size))))))
