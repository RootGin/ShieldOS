(defwindow background
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "100%"
                      :height "100%"
                      :anchor "top left")
  :stacking "bottom"
  :exclusive false
  :focusable false
  :namespace "shield-background"
  (box :class "canvas"
       :hexpand true
       :vexpand true
       (label :visible false
              :text "${telemetry.time} ${telemetry.day} ${telemetry.month_year} ${telemetry.weekday}")))
