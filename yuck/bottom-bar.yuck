(defwindow bottom
  :monitor 0
  :geometry (geometry :x "-48px"
                      :y "-54px"
                      :width "100%"
                      :anchor "bottom left")
  :layer "top"
  :exclusive false
  :focusable false
  :namespace "shield-bottom-bar"
  (box :class "bottom-bar"
       :orientation "horizontal"
       :space-evenly false
       :height bar_bottom_height
    (box :class "corner-housing-bl"
         :width corner_bottom_left_width
         :height corner_bottom_left_height
         :valign "end"
      (overlay
        (image :path "./assets/panels/corner-bottom-left.svg"
               :image-width corner_bottom_left_width
               :image-height corner_bottom_left_height
               :width corner_bottom_left_width
               :height corner_bottom_left_height)
        (box :class "bottom-left-container"
             :width corner_bottom_left_width
             :height corner_bottom_left_height
             :orientation "horizontal"
             :space-evenly false
             :halign "start"
             :valign "end"
          (box :class "status-pill"
               :width status_pill_width
               :height status_pill_height
               :valign "end"
            (overlay
              (image :path {network_audio.connected ? "./assets/panels/status-pill-connected.svg" : "./assets/panels/status-pill-disconnected.svg"}
                     :image-width status_pill_width
                     :image-height status_pill_height
                     :width status_pill_width
                     :height status_pill_height)
              (box :class "status-pill-content"
                   :orientation "horizontal"
                   :space-evenly false
                   :halign "start"
                   :valign "center"
                (box :class "status-pill-glyph"
                     :valign "center"
                  (image :path "./assets/panels/robot-glyph.svg"
                         :image-width status_pill_glyph_size
                         :image-height status_pill_glyph_size))
                (box :class "status-pill-label-box"
                     :valign "center"
                  (label :class "status-pill-label"
                         :text {network_audio.label})))))
          (box :class "status-equalizer-gap"
               :width status_pill_gap)
          (eventbox :class "equalizer-pod-eventbox"
                    :onclick "bin/shield-ctl toggle-mute"
                    :valign "end"
            (box :class "equalizer-pod"
                 :width equalizer_pod_width
                 :height equalizer_pod_height
                 :valign "end"
              (overlay
                (image :path "./assets/panels/equalizer-pod.svg"
                       :image-width equalizer_pod_width
                       :image-height equalizer_pod_height
                       :width equalizer_pod_width
                       :height equalizer_pod_height)
                (box :class "equalizer-bars"
                     :orientation "horizontal"
                     :space-evenly false
                     :halign "center"
                     :valign "center"
                  (box :class "equalizer-bar bar-1"
                       :valign "center")
                  (box :class "equalizer-bar-spacing"
                       :width equalizer_bar_gap)
                  (box :class "equalizer-bar bar-2"
                       :valign "center")
                  (box :class "equalizer-bar-spacing"
                       :width equalizer_bar_gap)
                  (box :class "equalizer-bar bar-3"
                       :valign "center")
                  (box :class "equalizer-bar-spacing"
                       :width equalizer_bar_gap)
                  (box :class "equalizer-bar bar-4"
                       :valign "center")
                  (box :class "equalizer-bar-spacing"
                       :width equalizer_bar_gap)
                  (box :class "equalizer-bar bar-5"
                       :valign "center"))))))))
    (box :class "bottom-rail"
         :hexpand true
         :height rail_bottom_height
         :valign "end"
      (box :class "bottom-rail-groove"
           :hexpand true
           :vexpand true
        (box :class "bottom-dock-slot"
             :hexpand true
             :space-evenly false)))
    (box :class "corner-housing-br"
         :width corner_bottom_right_width
         :height corner_bottom_right_height
         :valign "end"
      (overlay
        (image :path "./assets/panels/corner-bottom-right.svg"
               :image-width corner_bottom_right_width
               :image-height corner_bottom_right_height
               :width corner_bottom_right_width
               :height corner_bottom_right_height)
        (box :class "layer-localshare"
             :width corner_bottom_right_width
             :height corner_bottom_right_height
             :orientation "horizontal"
             :space-evenly false
             :valign "end"
          (box :class "indent-localshare"
               :width bottom_menu_utility_offset_localshare)
          (eventbox :class "utility-btn-eventbox"
                    :onclick "bin/shield-ctl localshare"
                    :valign "end"
            (box :class "utility-btn utility-localshare"
                 :width bottom_menu_utility_width
                 :height bottom_menu_utility_height
                 :valign "end"
              (overlay
                (image :path "./assets/panels/utility-button.svg"
                       :image-width bottom_menu_utility_width
                       :image-height bottom_menu_utility_height
                       :width bottom_menu_utility_width
                       :height bottom_menu_utility_height)
                (box :class "utility-btn-content"
                     :width bottom_menu_utility_width
                     :height bottom_menu_utility_height
                     :orientation "horizontal"
                     :space-evenly false
                     :halign "center"
                     :valign "center"
                  (image :class "utility-btn-icon"
                         :path "./assets/panels/icon-localshare.svg"
                         :image-width bottom_menu_utility_icon_size
                         :image-height bottom_menu_utility_icon_size
                         :width bottom_menu_utility_icon_size
                         :height bottom_menu_utility_icon_size)
                  (box :class "utility-btn-label-spacing"
                       :width bottom_menu_utility_label_spacing)
                  (label :class "utility-btn-label"
                         :text "LOCALSHARE"))))))
        (box :class "layer-websearch"
             :width corner_bottom_right_width
             :height corner_bottom_right_height
             :orientation "horizontal"
             :space-evenly false
             :valign "end"
          (box :class "indent-websearch"
               :width bottom_menu_utility_offset_websearch)
          (eventbox :class "utility-btn-eventbox"
                    :onclick "bin/shield-ctl websearch"
                    :valign "end"
            (box :class "utility-btn utility-websearch"
                 :width bottom_menu_utility_width
                 :height bottom_menu_utility_height
                 :valign "end"
              (overlay
                (image :path "./assets/panels/utility-button.svg"
                       :image-width bottom_menu_utility_width
                       :image-height bottom_menu_utility_height
                       :width bottom_menu_utility_width
                       :height bottom_menu_utility_height)
                (box :class "utility-btn-content"
                     :width bottom_menu_utility_width
                     :height bottom_menu_utility_height
                     :orientation "horizontal"
                     :space-evenly false
                     :halign "center"
                     :valign "center"
                  (image :class "utility-btn-icon"
                         :path "./assets/panels/icon-websearch.svg"
                         :image-width bottom_menu_utility_icon_size
                         :image-height bottom_menu_utility_icon_size
                         :width bottom_menu_utility_icon_size
                         :height bottom_menu_utility_icon_size)
                  (box :class "utility-btn-label-spacing"
                       :width bottom_menu_utility_label_spacing)
                  (label :class "utility-btn-label"
                         :text "WEBSEARCH"))))))
        (box :class "layer-colors"
             :width corner_bottom_right_width
             :height corner_bottom_right_height
             :orientation "horizontal"
             :space-evenly false
             :valign "end"
          (box :class "indent-colors"
               :width bottom_menu_utility_offset_colors)
          (eventbox :class "utility-btn-eventbox"
                    :onclick "bin/shield-ctl colors"
                    :valign "end"
            (box :class "utility-btn utility-colors"
                 :width bottom_menu_utility_sm_width
                 :height bottom_menu_utility_height
                 :valign "end"
              (overlay
                (image :path "./assets/panels/utility-button-sm.svg"
                       :image-width bottom_menu_utility_sm_width
                       :image-height bottom_menu_utility_height
                       :width bottom_menu_utility_sm_width
                       :height bottom_menu_utility_height)
                (box :class "utility-btn-content"
                     :width bottom_menu_utility_sm_width
                     :height bottom_menu_utility_height
                     :orientation "horizontal"
                     :space-evenly false
                     :halign "center"
                     :valign "center"
                  (image :class "utility-btn-icon"
                         :path "./assets/panels/icon-colors.svg"
                         :image-width bottom_menu_utility_icon_size
                         :image-height bottom_menu_utility_icon_size
                         :width bottom_menu_utility_icon_size
                         :height bottom_menu_utility_icon_size)
                  (box :class "utility-btn-label-spacing"
                       :width bottom_menu_utility_label_spacing)
                  (label :class "utility-btn-label"
                         :text "COLORS"))))))
        (box :class "layer-powermenu"
             :width corner_bottom_right_width
             :height corner_bottom_right_height
             :orientation "horizontal"
             :space-evenly false
             :valign "end"
          (box :class "indent-powermenu"
               :width bottom_menu_tab_offset_powermenu)
          (eventbox :class "trapezoid-tab-eventbox"
                    :onclick "bin/shield-ctl powermenu"
                    :valign "end"
            (box :class "trapezoid-tab tab-powermenu"
                 :width bottom_menu_tab_width
                 :height bottom_menu_tab_height
                 :valign "end"
              (overlay
                (image :path "./assets/panels/tab-trapezoid-normal.svg"
                       :image-width bottom_menu_tab_width
                       :image-height bottom_menu_tab_height
                       :width bottom_menu_tab_width
                       :height bottom_menu_tab_height)
                (box :class "trapezoid-tab-content"
                     :width bottom_menu_tab_width
                     :height bottom_menu_tab_height
                     :halign "center"
                     :valign "center"
                  (label :class "trapezoid-tab-label"
                         :text "POWERMENU"))))))
        (box :class "layer-bluetooth"
             :width corner_bottom_right_width
             :height corner_bottom_right_height
             :orientation "horizontal"
             :space-evenly false
             :valign "end"
          (box :class "indent-bluetooth"
               :width bottom_menu_tab_offset_bluetooth)
          (eventbox :class "trapezoid-tab-eventbox"
                    :onclick "bin/shield-ctl bluetooth"
                    :valign "end"
            (box :class "trapezoid-tab tab-bluetooth"
                 :width bottom_menu_tab_width
                 :height bottom_menu_tab_height
                 :valign "end"
              (overlay
                (image :path "./assets/panels/tab-trapezoid-normal.svg"
                       :image-width bottom_menu_tab_width
                       :image-height bottom_menu_tab_height
                       :width bottom_menu_tab_width
                       :height bottom_menu_tab_height)
                (box :class "trapezoid-tab-content"
                     :width bottom_menu_tab_width
                     :height bottom_menu_tab_height
                     :halign "center"
                     :valign "center"
                  (label :class "trapezoid-tab-label"
                         :text "BLUETOOTH"))))))
        (box :class "layer-applications"
             :width corner_bottom_right_width
             :height corner_bottom_right_height
             :orientation "horizontal"
             :space-evenly false
             :valign "end"
          (box :class "indent-applications"
               :width bottom_menu_tab_offset_applications)
          (eventbox :class "trapezoid-tab-eventbox"
                    :onclick "bin/shield-ctl applications"
                    :valign "end"
            (box :class "trapezoid-tab tab-applications active"
                 :width bottom_menu_tab_app_width
                 :height bottom_menu_tab_height
                 :valign "end"
              (overlay
                (image :path "./assets/panels/tab-trapezoid-active.svg"
                       :image-width bottom_menu_tab_app_width
                       :image-height bottom_menu_tab_height
                       :width bottom_menu_tab_app_width
                       :height bottom_menu_tab_height)
                (box :class "trapezoid-tab-content"
                     :width bottom_menu_tab_app_width
                     :height bottom_menu_tab_height
                     :halign "center"
                     :valign "center"
                  (label :class "trapezoid-tab-label active"
                         :text "APPLICATIONS"))))))))))
