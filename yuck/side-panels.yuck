(defwindow left
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "30px"
                      :anchor "left center")
  :layer "top"
  :exclusive false
  :focusable false
  :namespace "shield-left-panel"
  (box :class "left-panel"
       :orientation "vertical"
       :space-evenly false
       :width side_left_width
       :height side_left_height
    (box :class "left-dock-container"
         :halign "start"
         :width left_dock_width
         :height left_dock_height
      (overlay
        (image :path "./assets/panels/dock-left.svg"
               :image-width left_dock_width
               :image-height left_dock_height
               :width left_dock_width
               :height left_dock_height)
        (box :class "left-dock-content"
             :orientation "vertical"
             :space-evenly false
             :width left_dock_width
             :height left_dock_height
          (box :class "dock-pad-top"
               :height left_dock_play_pad_top)
          (box :class "dock-play-row"
               :orientation "horizontal"
               :space-evenly false
            (box :class "dock-play-indent"
                 :width left_dock_play_pad_left)
            (eventbox :class "play-trigger-eventbox"
                      :onclick "bin/shield-ctl play-pause"
              (box :class "play-trigger"
                   :width left_dock_play_size
                   :height left_dock_play_size
                   :halign "center"
                   :valign "center"
                (image :class "play-glyph-image"
                       :path {network_audio.media.playing ? "./assets/panels/icon-pause.svg" : "./assets/panels/icon-play.svg"}
                       :image-width left_dock_play_size
                       :image-height left_dock_play_size
                       :width left_dock_play_size
                       :height left_dock_play_size))))
          (box :class "dock-slot-pad"
               :height left_dock_slot_gap)
          (box :class "dock-slots-row"
               :orientation "horizontal"
               :space-evenly false
            (box :class "dock-slots-indent"
                 :width left_dock_slot_pad_left)
            (box :class "dock-slots"
                 :orientation "vertical"
                 :space-evenly false
                 :width left_dock_slot_width
              (box :class "dock-slot slot-4 ${network_audio.media.slots >= 4 ? 'active' : ''}"
                   :width left_dock_slot_width
                   :height left_dock_slot_tall_height)
              (box :class "dock-slot-gap"
                   :height left_dock_slot_gap)
              (box :class "dock-slot slot-3 ${network_audio.media.slots >= 3 ? 'active' : ''}"
                   :width left_dock_slot_width
                   :height left_dock_slot_short_height)
              (box :class "dock-slot-gap"
                   :height left_dock_slot_gap)
              (box :class "dock-slot slot-2 ${network_audio.media.slots >= 2 ? 'active' : ''}"
                   :width left_dock_slot_width
                   :height left_dock_slot_short_height)
              (box :class "dock-slot-gap"
                   :height left_dock_slot_gap)
              (box :class "dock-slot slot-1 ${network_audio.media.slots >= 1 ? 'active' : ''}"
                   :width left_dock_slot_width
                   :height left_dock_slot_short_height)))
          (box :class "dock-pips-pad"
               :height left_dock_pip_pad_top)
          (box :class "dock-pips-row"
               :orientation "horizontal"
               :space-evenly false
            (box :class "dock-pips-indent"
                 :width left_dock_pip_pad_left)
            (box :class "dock-pips"
                 :orientation "vertical"
                 :space-evenly false
                 :width left_dock_pip_size
              (box :class "dock-pip pip-1"
                   :width left_dock_pip_size
                   :height left_dock_pip_size)
              (box :class "dock-pip-gap"
                   :height left_dock_pip_gap)
              (box :class "dock-pip pip-2"
                   :width left_dock_pip_size
                   :height left_dock_pip_size)
              (box :class "dock-pip-gap"
                   :height left_dock_pip_gap)
              (box :class "dock-pip pip-3 active"
                   :width left_dock_pip_size
                   :height left_dock_pip_size))))))
    (box :class "left-gap"
         :height left_dock_rail_gap)
    (box :class "left-rail"
         :halign "start"
         :width rail_left_width
         :height left_dock_rail_height
      (image :path "./assets/panels/rail-left.svg"
             :image-width rail_left_width
             :image-height left_dock_rail_height
             :width rail_left_width
             :height left_dock_rail_height))))

(defwindow right
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "-26px"
                      :anchor "top right")
  :layer "top"
  :exclusive false
  :focusable false
  :namespace "shield-right-panel"
  (box :class "right-panel"
       :orientation "vertical"
       :space-evenly false
       :halign "end"
       :width side_right_width
       :height side_right_height
    (box :class "right-upper-rail-container"
         :halign "end"
         :width side_right_upper_width
         :height side_right_upper_height
      (image :path "./assets/panels/rail-right-upper.svg"
             :image-width side_right_upper_width
             :image-height side_right_upper_height))
    (box :class "right-gap-1"
         :height gauge_gap_upper)
    (box :class "right-gauges"
         :orientation "vertical"
         :space-evenly false
         :halign "end"
         :width gauge_width
      (box :class "gauge cpu-gauge"
           :orientation "vertical"
           :space-evenly false
           :width gauge_width
        (box :class "gauge-header cpu-header"
             :width gauge_width
             :height gauge_header_height
          (box :class "gauge-header-label-box"
               :halign "center"
               :valign "center"
            (label :class "gauge-header-text"
                   :text "CPU")))
        (box :class "gauge-rungs cpu-rungs"
             :orientation "vertical"
             :space-evenly false
             :width gauge_width
          (for rung in {telemetry.cpu_ladder.rungs}
            (box :class "gauge-rung ${rung.state} ${rung.sublabel != '' ? 'dual' : 'single'}"
                 :orientation "vertical"
                 :space-evenly false
                 :width gauge_width
              (box :class "rung-label-box"
                   :halign "center"
                   :valign "center"
                (label :class "rung-label-text ${rung.state}"
                       :text "${rung.label}"))
              (box :class "rung-sublabel-box"
                   :visible {rung.sublabel != ""}
                   :halign "center"
                   :valign "center"
                (label :class "rung-sublabel-text ${rung.state}"
                       :text "${rung.sublabel}"))))))
      (box :class "gauge-gap"
           :height gauge_gap)
      (box :class "gauge ram-gauge"
           :orientation "vertical"
           :space-evenly false
           :width gauge_width
        (box :class "gauge-header ram-header"
             :width gauge_width
             :height gauge_header_height
          (box :class "gauge-header-label-box"
               :halign "center"
               :valign "center"
            (label :class "gauge-header-text"
                   :text "RAM")))
        (box :class "gauge-rungs ram-rungs"
             :orientation "vertical"
             :space-evenly false
             :width gauge_width
          (for rung in {telemetry.ram_ladder.rungs}
            (box :class "gauge-rung ${rung.state} single"
                 :orientation "vertical"
                 :space-evenly false
                 :width gauge_width
              (box :class "rung-label-box"
                   :halign "center"
                   :valign "center"
                (label :class "rung-label-text ${rung.state}"
                       :text "${rung.label}")))))))
    (box :class "right-gap-2"
         :height gauge_gap_lower)
    (box :class "right-lower-housing-container"
         :halign "end"
         :width side_right_lower_width
         :height side_right_lower_height
      (overlay
        (image :path "./assets/panels/rail-right-lower.svg"
               :image-width side_right_lower_width
               :image-height side_right_lower_height)
        (box :class "volume-cluster"
             :orientation "vertical"
             :space-evenly false
             :width side_right_lower_width
             :height side_right_lower_height
             :valign "start"
             :halign "end"
          (box :class "lower-housing-pad"
               :height volume_housing_pad_top)
          (eventbox :class "volume-btn-eventbox volume-up"
                    :onclick "bin/shield-ctl volume up"
            (box :class "volume-slot"
                 :orientation "horizontal"
                 :space-evenly false
                 :halign "end"
              (box :class "volume-bar"
                   :width volume_bar_width
                   :height volume_bar_height
                   :valign "center")
              (box :class "volume-bar-gap"
                   :width volume_bar_gap)
              (box :class "volume-pill"
                   :width volume_pill_width
                   :height volume_pill_height
                (box :class "volume-pill-body"
                     :vexpand true
                     :hexpand true
                     :halign "fill"
                     :valign "fill"
                  (label :class "volume-pill-label"
                         :halign "center"
                         :valign "center"
                         :text "E")))))
          (box :class "volume-gap"
               :height volume_pill_gap)
          (eventbox :class "volume-btn-eventbox volume-display-eventbox"
                    :onscroll "if [ '{}' = 'up' ]; then bin/shield-ctl volume up; else bin/shield-ctl volume down; fi"
            (box :class "volume-slot"
                 :orientation "horizontal"
                 :space-evenly false
                 :halign "end"
              (box :class "volume-bar"
                   :width volume_bar_width
                   :height volume_bar_height
                   :valign "center")
              (box :class "volume-bar-gap"
                   :width volume_bar_gap)
              (box :class "volume-pill volume-display-pill"
                   :width volume_pill_width
                   :height volume_pill_height
                (box :class "volume-pill-body volume-display-body"
                     :vexpand true
                     :hexpand true
                     :halign "fill"
                     :valign "fill"
                  (label :class "volume-pill-label volume-display-label"
                         :halign "center"
                         :valign "center"
                         :text "${current_volume}")))))
          (box :class "volume-gap"
               :height volume_pill_gap)
          (eventbox :class "volume-btn-eventbox volume-down"
                    :onclick "bin/shield-ctl volume down"
            (box :class "volume-slot"
                 :orientation "horizontal"
                 :space-evenly false
                 :halign "end"
              (box :class "volume-bar"
                   :width volume_bar_width
                   :height volume_bar_height
                   :valign "center")
              (box :class "volume-bar-gap"
                   :width volume_bar_gap)
              (box :class "volume-pill"
                   :width volume_pill_width
                   :height volume_pill_height
                (box :class "volume-pill-body"
                     :vexpand true
                     :hexpand true
                     :halign "fill"
                     :valign "fill"
                  (label :class "volume-pill-label"
                         :halign "center"
                         :valign "center"
                         :text "L"))))))))))
