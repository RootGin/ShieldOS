(defwindow top
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "100%"
                      :anchor "top center")
  :layer "top"
  :exclusive true
  :focusable false
  :namespace "shield-top-bar"
  (box :class "top-bar"
       :orientation "horizontal"
       :space-evenly false
       :height bar_top_height
    (box :class "corner-housing-tl"
         :width corner_top_left_width
         :height corner_top_left_height
         :valign "start"
      (overlay
        (image :path "./assets/panels/corner-top-left.svg"
               :image-width corner_top_left_width
               :image-height corner_top_left_height)
        (box :class "operator-module"
             :width corner_top_left_width
             :height corner_top_left_height
             :orientation "horizontal"
             :space-evenly false
          (box :class "operator-medallion-box"
               :valign "start"
            (image :path "./assets/profile.png"
                   :image-width operator_medallion_size
                   :image-height operator_medallion_size))
          (box :class "operator-content"
               :orientation "vertical"
               :space-evenly false
               :valign "start"
            (box :class "operator-segments"
                 :orientation "horizontal"
                 :space-evenly false
              (box :class "segment dim wide")
              (box :class "segment dim short")
              (box :class "segment bright wide")
              (box :class "segment bright med"))
            (box :class "operator-clock-row"
                 :orientation "horizontal"
                 :space-evenly false
              (box :class "operator-left-col"
                   :orientation "vertical"
                   :space-evenly false
                   :valign "start"
                (box :class "operator-clock"
                     :halign "start"
                  (label :class "clock-text"
                         :text {telemetry.time}))
                (box :class "operator-prefix"
                     :halign "start"
                  (label :class "prefix-text"
                         :text "OPERATOR:")))
              (box :class "operator-version-badge"
                   :valign "center"
                (overlay
                  (image :path "./assets/panels/version-badge.svg"
                         :image-width 56
                         :image-height 42)
                  (box :class "version-badge-content"
                       :width 56
                       :height 42
                       :halign "center"
                       :valign "center"
                    (label :class "version-text"
                           :text {telemetry.version})))))
            (box :class "operator-id-row"
                 :orientation "horizontal"
                 :space-evenly false
              (box :class "operator-user"
                   :halign "start"
                (label :class "user-text"
                       :halign "start"
                       :text {telemetry.user})))
            (box :class "operator-sub-row"
                 :orientation "horizontal"
                 :space-evenly false
              (box :class "operator-sub"
                (label :class "sub-text"
                       :text {telemetry.kernel}))))
          (box :class "operator-radar-icons"
               :orientation "horizontal"
               :space-evenly false
               :valign "start"
            (box :class "radar-icon-box"
              (image :path "./assets/panels/icon-radar-ring.svg"
                     :image-width operator_icon_size
                     :image-height operator_icon_size))
            (box :class "radar-icon-box"
              (image :path "./assets/panels/icon-radar-target.svg"
                     :image-width operator_icon_size
                     :image-height operator_icon_size))))))
    (box :class "top-center"
         :orientation "vertical"
         :space-evenly false
         :hexpand true
         :valign "start"
      (box :class "top-rail"
           :hexpand true
           :height rail_top_height
           :valign "start"
        (box :class "top-rail-groove"
             :hexpand true
             :vexpand true))
      (box :class "top-bar-deck"
           :orientation "horizontal"
           :space-evenly false
           :valign "start"
        (eventbox :class "workspace-strip-eventbox"
                  :valign "start"
                  :onscroll "if [ '{}' = 'up' ]; then bin/shield-ctl workspace prev; else bin/shield-ctl workspace next; fi"
          (box :class "workspace-strip"
               :orientation "horizontal"
               :space-evenly false
               :valign "start"
            (for ws in {compositor.workspaces}
              (eventbox :class "workspace-pill-eventbox"
                        :valign "start"
                        :onclick "bin/shield-ctl workspace ${ws.id}"
                (box :class "workspace-slot"
                     :orientation "horizontal"
                     :space-evenly false
                     :valign "start"
                  (box :class "workspace-pill-bar ${ws.state}"
                       :width workspace_pill_bar_width
                       :height workspace_pill_bar_height
                       :valign "start")
                  (box :class "workspace-pill ${ws.state}"
                       :orientation "vertical"
                       :space-evenly false
                       :width workspace_pill_width
                       :height workspace_pill_height
                       :valign "start"
                    (box :class "workspace-pill-body ${ws.state}"
                         :vexpand true
                         :hexpand true
                         :halign "fill"
                         :valign "fill"
                      (label :class "workspace-pill-label ${ws.state}"
                             :halign "center"
                             :valign "center"
                             :text "${ws.id}"))))))))
        (box :class "window-tabs-strip"
             :orientation "horizontal"
             :space-evenly false
             :valign "start"
          (for tab in {compositor.tabs}
            (eventbox :class "window-tab-eventbox"
                      :valign "start"
                      :onclick "bin/shield-ctl focus ${tab.id}"
              (box :class "window-tab-slot"
                   :orientation "horizontal"
                   :space-evenly false
                   :valign "start"
                (label :class "tab-anchor"
                       :valign "start"
                       :text "F:")
                (box :class "window-tab ${tab.urgent ? 'urgent' : 'normal'}"
                     :orientation "vertical"
                     :space-evenly false
                     :valign "start"
                  (box :class "tab-main"
                       :orientation "horizontal"
                       :space-evenly false
                       :valign "start"
                    (box :class "tab-tag-box"
                         :valign "start"
                      (label :class "tab-tag-text"
                             :halign "start"
                             :valign "start"
                             :text "${tab.tag}"))
                    (box :class "tab-title-box"
                         :valign "start"
                      (label :class "tab-title-text"
                             :halign "start"
                             :valign "start"
                             :text "${tab.title}")))
                  (box :class "tab-sub-row"
                       :orientation "horizontal"
                       :space-evenly false
                       :valign "start"
                    (box :class "tab-sub-line"
                         :hexpand true)
                    (box :class "tab-badge ${tab.urgent ? 'urgent' : 'normal'}"
                         :valign "start"
                      (label :class "tab-badge-text ${tab.urgent ? 'urgent' : 'normal'}"
                             :halign "center"
                             :valign "center"
                             :text "${tab.badge}"))))))))))
    (box :class "corner-housing-tr"
         :width corner_top_right_width
         :height corner_top_right_height
         :valign "start"
      (overlay
        (image :path "./assets/panels/corner-top-right.svg"
               :image-width corner_top_right_width
               :image-height corner_top_right_height)
        (box :class "date-block"
             :width corner_top_right_width
             :height corner_top_right_height
             :orientation "horizontal"
             :space-evenly false
             :halign "end"
             :valign "center"
          (box :class "date-column"
               :width 108
               :orientation "vertical"
               :space-evenly false
               :hexpand true
               :halign "end"
               :valign "center"
            (box :class "date-day"
                 :halign "center"
                 :tooltip {telemetry.day}
              (image :path "./assets/panels/date-day.svg"
                     :image-width 103
                     :image-height 26))
            (box :class "date-pill"
                 :halign "center"
              (overlay
                (image :path "./assets/panels/date-pill.svg"
                       :image-width 108
                       :image-height 25)
                (box :class "date-pill-content"
                     :width 108
                     :height 25
                     :halign "center"
                     :valign "center"
                  (label :class "pill-text"
                         :text {telemetry.month_year}))))
            (box :class "date-weekday"
                 :halign "end"
              (label :class "weekday-text"
                     :text {telemetry.weekday}))))))))

